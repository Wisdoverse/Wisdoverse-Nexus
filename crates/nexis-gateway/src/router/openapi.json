    "/v1/messages": {
      "post": {
        "summary": "Send message",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Committed message; same key and payload return the same identity without another broadcast",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            }
          },
          "400": {
            "description": "Blank/oversize text, invalid retry key, or reply outside this room"
          },
          "401": {
            "description": "Missing, invalid, expired, or tenant-scoped credentials"
          },
          "404": {
            "description": "Room does not exist"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "503": {
            "description": "Unsupported multi-tenant mode or retry capacity exhausted"
          },
          "403": {
            "description": "Member is not authorized for this room operation"
          },
          "409": {
            "description": "Retry key reused with different text or reply reference"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MessageCreate"
              }
            }
          }
        }
      }
    },
