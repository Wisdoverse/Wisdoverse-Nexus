        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Room messages",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
