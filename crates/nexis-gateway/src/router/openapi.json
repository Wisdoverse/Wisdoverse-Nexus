  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "parameters": {
      "ApiVersion": {
        "name": "x-api-version",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "enum": [
            "1"
          ]
        }
      },
      "RoomId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "CollaborationRoomId": {
        "name": "room_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "DocumentId": {
        "name": "document_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "TaskId": {
        "name": "task_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Validation or request contract error"
      },
      "Unauthorized": {
        "description": "Missing or invalid authorization token"
      },
      "NotFound": {
        "description": "Resource not found"
      },
      "RateLimited": {
        "description": "Rate limit exceeded"
      },
      "ServiceUnavailable": {
        "description": "Dependent service unavailable"
      }
    },
    "schemas": {
      "Session": {
        "type": "object",
        "properties": {
          "memberId": {
            "type": "string"
          },
          "memberType": {
            "type": "string",
            "enum": [
              "human",
              "ai"
            ]
          },
          "expiresAt": {
            "type": "integer",
            "format": "int64",
            "description": "JWT expiry in milliseconds since Unix epoch"
          },
          "refreshSupported": {
            "type": "boolean",
            "enum": [
              false
            ]
          }
        },
        "required": [
          "memberId",
          "memberType",
          "expiresAt",
          "refreshSupported"
        ]
      },
      "Message": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "roomId": {
            "type": "string"
          },
          "sender": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "reply_to": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "roomId",
          "sender",
          "text"
        ]
      },
      "RoomSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "topic": {
            "type": "string"
          },
          "member_count": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "RoomCreated": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "RoomDetails": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "topic": {
            "type": "string"
          },
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Message"
            }
          }
        },
        "required": [
          "id",
          "name",
          "messages"
        ]
      },
      "RoomList": {
        "type": "object",
        "properties": {
          "rooms": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RoomSummary"
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "rooms",
          "total"
        ]
      },
      "MessageCreate": {
        "type": "object",
        "properties": {
          "roomId": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "description": "Nonblank UTF-8 text, at most 32768 bytes"
          },
          "replyTo": {
            "type": "string",
            "nullable": true
          },
          "sender": {
            "type": "string",
            "deprecated": true,
            "description": "Ignored; JWT subject is authoritative"
          },
          "clientMessageId": {
            "type": "string",
            "minLength": 1,
