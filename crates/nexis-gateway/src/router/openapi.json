{
  "openapi": "3.0.3",
  "info": {
    "title": "Wisdoverse Nexus Gateway API",
    "version": "0.1.0",
    "description": "Control plane API for room management, messaging, semantic search, privacy self-service, and collaboration."
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "Gateway is healthy"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Prometheus metrics",
        "responses": {
          "200": {
            "description": "Metrics payload"
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "summary": "OpenAPI contract",
        "responses": {
          "200": {
            "description": "OpenAPI document"
          }
        }
      }
    },
    "/docs": {
      "get": {
        "summary": "Swagger UI",
        "responses": {
          "200": {
            "description": "Swagger UI HTML"
          }
        }
      }
    },
    "/ws": {
      "get": {
        "summary": "WebSocket upgrade endpoint",
        "responses": {
          "101": {
            "description": "WebSocket connection established"
          }
        },
        "description": "First message: auth {token}; then join_room {room_id}. JWT scope and room membership are checked. send_message accepts room_id, content, reply_to and client_message_id. message_accepted acknowledges every accepted retry; new_message is emitted once on commit. Heartbeat timestamps and event timestamps are milliseconds. Reload HTTP history after reconnect. Default single-tenant features only."
      }
    },
    "/v1/rooms": {
      "get": {
        "summary": "List rooms",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized rooms only",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoomList"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, expired, or tenant-scoped credentials"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "403": {
            "description": "Member is not authorized for this room operation"
          },
          "404": {
            "description": "Room does not exist"
          },
          "503": {
            "description": "Unsupported multi-tenant mode or retry capacity exhausted"
          }
        }
      },
      "post": {
        "summary": "Create room",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Room created with JWT subject as owner",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoomCreated"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "description": "Missing, invalid, expired, or tenant-scoped credentials"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "503": {
            "description": "Unsupported multi-tenant mode or retry capacity exhausted"
          },
          "403": {
            "description": "Member is not authorized for this room operation"
          },
          "404": {
            "description": "Room does not exist"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RoomCreate"
              }
            }
          }
        }
      }
    },
